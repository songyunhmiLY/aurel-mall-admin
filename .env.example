# aurel-mall-api 的基址，末尾不要加斜杠。
# 管理端在本机开发；接口和数据库在远程 Linux 主机的 Docker 里，不在 Windows 本机。
# 把下面的地址改成那台主机，例如 http://192.168.1.10:3000/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# 静态资源和路由的基路径。根路径部署用 /。预览挂在 /admin/ 时改成 /admin/
# 也可以在构建时写 npm run build -- --base=/admin/，命令行优先于这里。
VITE_BASE=/

# 仿真演练菜单与路由（/simulation）。构建时打进产物，改这个值必须重新构建。
# staging 构建设 true；正式构建不要设（或显式设 false），/simulation 会落到「页面不存在」。
# 后端还要 DEPLOY_NODE_ENV=staging + SIMULATION_ENABLED=true + ALLOW_CLOCK_OVERRIDE=true，
# 否则页面能打开但所有接口返回 403。
VITE_SIMULATION_ENABLED=false
